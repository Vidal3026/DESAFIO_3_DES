<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RecetasDB">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=RecetasDB;TrustServerCertificate=True</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>5da8acc4-6bd0-4077-b329-fa5b13daa568</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DatosRecetas">
      <Query>
        <DataSourceName>RecetasDB</DataSourceName>
        <QueryParameters><QueryParameter Name="@TiempoMaximo"><Value>=Parameters!TiempoMaximo.Value</Value></QueryParameter></QueryParameters>
        <CommandText>SELECT r.Nombre AS Receta,
       r.TiempoPreparacion AS TiempoMinutos,
       i.Nombre AS Ingrediente,
       i.Cantidad,
       i.UnidadMedida
FROM Recetas r
LEFT JOIN Ingredientes i ON i.RecetaId = r.Id
WHERE r.TiempoPreparacion &lt;= @TiempoMaximo
ORDER BY r.TiempoPreparacion, r.Nombre, i.Nombre</CommandText>
      </Query>
      <Fields><Field Name="Receta"><DataField>Receta</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TiempoMinutos"><DataField>TiempoMinutos</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Ingrediente"><DataField>Ingrediente</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Cantidad"><DataField>Cantidad</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="UnidadMedida"><DataField>UnidadMedida</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Titulo">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
