  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>="Recetas con tiempo de preparación de hasta " &amp; Parameters!TiempoMaximo.Value &amp; " minutos  ·  Total de recetas: " &amp; CountDistinct(Fields!Receta.Value, "DatosRecetas")</Value>
          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#555555</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Left</TextAlign></Style>
    </Paragraph>
