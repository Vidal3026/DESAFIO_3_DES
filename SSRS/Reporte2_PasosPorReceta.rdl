<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RecetasDB">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=RecetasDB;TrustServerCertificate=True</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>97dc2e0c-b648-4e95-b255-ecffba0d4d09</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DatosPasos">
      <Query>
        <DataSourceName>RecetasDB</DataSourceName>
        
        <CommandText>SELECT r.Nombre AS Receta,
       COUNT(p.Id) OVER (PARTITION BY r.Id) AS TotalPasos,
       p.Orden,
       p.Descripcion AS Paso
FROM Recetas r
LEFT JOIN PasosPreparacion p ON p.RecetaId = r.Id
ORDER BY r.Nombre, p.Orden</CommandText>
      </Query>
      <Fields><Field Name="Receta"><DataField>Receta</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TotalPasos"><DataField>TotalPasos</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Orden"><DataField>Orden</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Paso"><DataField>Paso</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Titulo">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>Pasos de preparación por receta</Value>
          <Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Left</TextAlign></Style>
    </Paragraph>
  </Paragraphs>
  <Top>0in</Top><Left>0in</Left><Height>0.4in</Height><Width>7in</Width>
  <Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
</Textbox>
          <Textbox Name="Subtitulo">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>="Cantidad de pasos de cada receta y el orden en que deben realizarse  ·  Total de recetas: " &amp; CountDistinct(Fields!Receta.Value, "DatosPasos")</Value>
          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#555555</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Left</TextAlign></Style>
    </Paragraph>
  </Paragraphs>
  <Top>0.4in</Top><Left>0in</Left><Height>0.3in</Height><Width>7in</Width>
  <Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
</Textbox>
          <Tablix Name="TablaPasos">
  <TablixBody>
    <TablixColumns><TablixColumn><Width>0.8in</Width></TablixColumn><TablixColumn><Width>4.7in</Width></TablixColumn><TablixColumn><Width>1.5in</Width></TablixColumn></TablixColumns>
    <TablixRows><TablixRow><Height>0.3in</Height><TablixCells><TablixCell><CellContents><Textbox Name="hOrden">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>Orden</Value>
          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Center</TextAlign></Style>
    </Paragraph>
  </Paragraphs>
  
  <Style><Border><Color>#B8C7D6</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
</Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hPaso">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
