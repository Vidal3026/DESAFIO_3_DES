          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Center</TextAlign></Style>
    </Paragraph>
  </Paragraphs>
  
  <Style><Border><Color>#B8C7D6</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
</Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.32in</Height><TablixCells><TablixCell><CellContents><Textbox Name="gReceta">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>=Fields!Receta.Value &amp; "   ·   " &amp; Fields!TotalPasos.Value &amp; " paso(s) de preparación"</Value>
          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Left</TextAlign></Style>
    </Paragraph>
  </Paragraphs>
  
  <Style><Border><Color>#B8C7D6</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#DCE9F5</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
</Textbox><ColSpan>3</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.27in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Orden">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>=Fields!Orden.Value</Value>
          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><Color>#222222</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Center</TextAlign></Style>
    </Paragraph>
  </Paragraphs>
  
  <Style><Border><Color>#B8C7D6</Color><Style>Solid</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
</Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Paso">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>=IIf(IsNothing(Fields!Paso.Value), "(sin pasos registrados)", Fields!Paso.Value)</Value>
          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><Color>#222222</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Left</TextAlign></Style>
    </Paragraph>
  </Paragraphs>
  
  <Style><Border><Color>#B8C7D6</Color><Style>Solid</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
</Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Estado">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>=IIf(IsNothing(Fields!Orden.Value), "", "Paso " &amp; Fields!Orden.Value &amp; " de " &amp; Fields!TotalPasos.Value)</Value>
          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><Color>#222222</Color></Style>
        </TextRun>
      </TextRuns>
      <Style><TextAlign>Center</TextAlign></Style>
